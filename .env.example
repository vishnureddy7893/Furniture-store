# Design studio — optional AI preview.
#
# The studio is fully functional with none of this set. Every interactive part
# (upload, dimensions, stone, edge, base, finish, the live preview) runs locally
# in the browser. These variables only enable the one optional step: the final
# photorealistic render on the review screen.
#
# Copy to `.env.local` (git-ignored) to use.

# --- server only. NEVER prefix a key with NEXT_PUBLIC_. ---------------------
# Set one of these to turn the "Generate realistic preview" button on.
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Pin a provider instead of using the first configured one ("gemini" | "openai").
# AI_PREVIEW_PROVIDER=gemini

# Override the model if needed.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-1

# --- public ----------------------------------------------------------------
# Set to "false" to hide the AI step entirely, even if a key is configured.
# Useful for a demo where the render should not be offered at all.
# NEXT_PUBLIC_AI_PREVIEW_ENABLED=false
